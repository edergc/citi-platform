DATABASE_URL=postgresql+psycopg://citi_app:changeme@localhost:5432/citi_platform
# Separate database used only by `pytest` (backend/tests/) — never the real DATABASE_URL.
# Create once: CREATE DATABASE citi_platform_test OWNER citi_app;
TEST_DATABASE_URL=postgresql+psycopg://citi_app:changeme@localhost:5432/citi_platform_test
SECRET_KEY=changeme-generate-a-real-secret
CONFIG_ENCRYPTION_KEY=changeme-fernet-key-generate-with-cryptography
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
